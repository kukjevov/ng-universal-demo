{
    "configuration":
    {
        "debug": true,
        "apiBaseUrl": "api/",
        "defaultApiHeaders": 
        {
            "Accept": "application/json",
            "Accept-Encoding": "br;q=1.0, gzip;q=0.8, deflate;q=0.7, *;q=0.1"
        },
        "themes":
        [
            "light",
            "dark"
        ],
        "languages":
        [
            {
                "lang": "en",
                "name": "English"
            },
            {
                "lang": "sk",
                "name": "Slovenčina"
            }
        ]
    },
    "general":
    {
        "theme": "dark",
        "language": "en"
    },
    "debug":
    {
        "consoleEnabled": true,
        "debugData": false
    },
    "logging":
    {
        "consoleLogLevel": "verbose"
    }
}