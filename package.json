{
    "name": "ng-universal-demo",
    "version": "1.0.0",
    "description": "Angular sample application",
    "type": "module",
    "scripts": {
        "build": "ng build --configuration development",
        "build:ssr": "webpack --env ssr",
        "build:min": "ng build",
        "prebuild": "npm run version:build",
        "prebuild:ssr": "npm run prebuild",
        "prebuild:min": "npm run clean && npm run version:build",
        "postbuild:ssr": "echo {\"type\": \"commonjs\"} > wwwroot/package.json",
        "clean": "rimraf wwwroot",
        "clean:deps": "rimraf package-lock.json node_modules || echo 'node_modules removed'",
        "clean:all": "npm run clean && npm run clean:deps",
        "version:build": "ngv -e \"node write.version.cjs\"",
        "server": "node server.js",
        "lint": "eslint app/**/*.ts",
        "start": "npm run version:build && concurrently \"npm run server -- --devPort\" \"ng serve\""
    },
    "engines": {
        "node": "^18.13.0 || >=20.9.0"
    },
    "author": "kukjevov",
    "license": "MIT",
